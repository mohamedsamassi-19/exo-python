temperatures = [12.5, 14, 9.5, 17, 21, 19.5, 11]


moyenne = sum(temperatures) / len(temperatures)
print(f"Moyenne : {round(moyenne, 2)}")
print(f"Min : {min(temperatures)} / Max : {max(temperatures)}")


compteur = 0
for temp in temperatures:
    if temp > 15:
        compteur += 1
print(f"Jours > 15 °C : {compteur}")


fahrenheit = []
for c in temperatures:
    f = c * 9 / 5 + 32
    fahrenheit.append(round(f, 1))
print(f"Fahrenheit : {fahrenheit}")


for numero, temp in enumerate(temperatures, start=1):
    print(f"Jour {numero} : {temp} °C")